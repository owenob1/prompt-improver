---
import Base from '@/layouts/Base.astro';
import { CodeBlock } from '@/components/CodeBlock';
import Section from '@/components/Section.astro';
import { SetupTabs } from '@/components/SetupTabs';
import { Badge } from '@/components/ui/badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';
import { ENDPOINT, HERO, META, REPO, STEPS, SURFACES } from '@/lib/site';
---

<Base title={META.title} description={META.description}>
  <main
    class="mx-auto flex max-w-content flex-col gap-section px-gutter py-page sm:px-gutter-wide sm:py-page-wide"
  >
    <header class="flex flex-col gap-stack">
      <ul class="flex flex-wrap gap-stack-tight">
        {HERO.badges.map((b, i) => <li><Badge variant={i === 0 ? 'secondary' : 'outline'}>{b}</Badge></li>)}
      </ul>
      <h1 class="text-display font-semibold tracking-tight">{HERO.title}</h1>
      <p class="max-w-prose text-lead text-muted-foreground">{HERO.lead}</p>
    </header>

    <Card>
      <CardHeader>
        <CardTitle>Endpoint</CardTitle>
        <CardDescription>Streamable HTTP. No sign-in needed.</CardDescription>
      </CardHeader>
      <CardContent>
        <CodeBlock client:load value={ENDPOINT} label="Copy URL" />
      </CardContent>
    </Card>

    <Section title="Connect">
      <SetupTabs client:load />
    </Section>

    <Section title="How it works">
      <ol class="grid gap-stack sm:grid-cols-3">
        {
          STEPS.map((step, i) => (
            <li>
              <Card className="h-full">
                <CardHeader>
                  <CardDescription>Step {i + 1}</CardDescription>
                  <CardTitle className="font-mono text-small">{step.title}</CardTitle>
                </CardHeader>
                <CardContent className="text-small text-muted-foreground">{step.body}</CardContent>
              </Card>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section title="What it exposes">
      <dl class="divide-y rounded-lg border">
        {
          SURFACES.map((s) => (
            <div class="flex flex-col gap-stack-tight p-inset-x sm:flex-row sm:gap-stack">
              <dt class="font-mono text-code sm:w-1/3 sm:shrink-0">{s.name}</dt>
              <dd class="text-small text-muted-foreground">
                <span class="font-medium text-foreground">{s.kind}.</span> {s.text}
              </dd>
            </div>
          ))
        }
      </dl>
    </Section>

    <footer
      class="flex flex-col gap-stack-tight border-t pt-stack text-small text-muted-foreground sm:flex-row sm:justify-between"
    >
      <span>Also available as an Agent Skill for coding CLIs.</span>
      <a
        class="wrap-anywhere underline underline-offset-4 hover:text-foreground"
        href={REPO.href}
        rel="nofollow noopener noreferrer">{REPO.label}</a
      >
    </footer>
  </main>
</Base>
