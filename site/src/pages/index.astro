---
// Two levels, per progressive disclosure: what everyone needs is visible (what it is, the endpoint,
// how to connect, the loop); the reference detail sits behind labelled disclosures.
// Hierarchy: one large element (the title), section titles, then body and small text; the endpoint
// is the only emphasised container.
import Base from '@/layouts/Base.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import Disclosure from '@/components/Disclosure.astro';
import KeyList from '@/components/KeyList.astro';
import Section from '@/components/Section.astro';
import { SetupTabs } from '@/components/SetupTabs';
import { API, ENDPOINT, HERO, META, NEXT_STEPS, REPO, SETUP, STEPS, SURFACES } from '@/lib/site';
---

<Base title={META.title} description={META.description}>
  <main
    class="mx-auto flex max-w-content flex-col gap-section px-gutter py-page sm:px-gutter-wide sm:py-page-wide"
  >
    <header class="flex flex-col gap-stack">
      <h1 class="text-display font-semibold tracking-tight">{HERO.title}</h1>
      <p class="max-w-prose text-title">{HERO.lead}</p>
      <p class="max-w-prose text-muted-foreground">{HERO.detail}</p>
      <p class="text-small text-muted-foreground">{HERO.meta.join(' · ')}</p>
    </header>

    <div class="flex flex-col gap-stack rounded-xl border bg-card p-gutter shadow-sm sm:p-gutter-wide">
      <p class="font-medium">Endpoint</p>
      <CodeBlock code={ENDPOINT} lang="text" label="Copy URL" />
    </div>

    <Section title="Connect">
      <SetupTabs client:load>
        <CodeBlock slot="claudeCode" code={SETUP.claudeCode} lang="bash" />
        <ol slot="chat" class="flex list-decimal flex-col gap-stack-tight pl-gutter text-muted-foreground">
          {SETUP.chatSteps.map((step) => <li>{step}</li>)}
        </ol>
        <CodeBlock slot="json" code={SETUP.json} lang="json" />
      </SetupTabs>
    </Section>

    <Section title="How it works">
      <ol class="grid gap-stack sm:grid-cols-3 sm:gap-gutter-wide">
        {
          STEPS.map((step, i) => (
            <li class="flex flex-col gap-stack-tight">
              <span class="text-small text-muted-foreground">Step {i + 1}</span>
              <span class="font-mono font-semibold">{step.title}</span>
              <span class="text-muted-foreground">{step.body}</span>
            </li>
          ))
        }
      </ol>
    </Section>

    <Section title="Reference">
      <div class="flex flex-col gap-stack-tight">
        {
          API.map((tool) => (
            <Disclosure mono title={tool.name} hint="Arguments and response">
              <p class="max-w-prose text-small text-muted-foreground">{tool.summary}</p>
              {[
                { label: 'Arguments', note: '', code: tool.request, lang: 'json' as const },
                { label: 'Response', note: tool.responseNote, code: tool.response, lang: tool.responseLang }
              ].map((part) => (
                <div class="flex flex-col gap-stack-tight">
                  <p class="text-small">
                    <span class="font-medium">{part.label}</span>
                    {part.note && <span class="text-muted-foreground"> · {part.note}</span>}
                  </p>
                  <CodeBlock code={part.code} lang={part.lang} />
                </div>
              ))}
            </Disclosure>
          ))
        }
        <Disclosure title="next_step values" hint="What the agent does after validating">
          <KeyList items={NEXT_STEPS.map((n) => ({ term: n.when, text: n.then }))} />
        </Disclosure>
        <Disclosure title="Everything the server exposes" hint="Tools, prompt and skill">
          <KeyList mono items={SURFACES.map((s) => ({ term: s.name, lead: s.kind, text: s.text }))} />
        </Disclosure>
      </div>
    </Section>

    <footer
      class="flex flex-col gap-stack-tight border-t pt-stack text-small text-muted-foreground sm:flex-row sm:justify-between"
    >
      <span>Also available as an Agent Skill for coding CLIs.</span>
      <a
        class="wrap-anywhere underline underline-offset-4 hover:text-foreground"
        href={REPO.href}
        rel="nofollow noopener noreferrer">{REPO.label}</a
      >
    </footer>
  </main>
</Base>
