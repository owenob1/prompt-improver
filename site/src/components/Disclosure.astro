---
// Second-level detail behind one labelled, native <details> toggle: no script, keyboard and
// screen-reader support built in. The summary says exactly what is inside.
interface Props {
  title: string;
  hint?: string;
  /** Set when the title is an identifier (a tool name). */
  mono?: boolean;
}
const { title, hint, mono = false } = Astro.props;
---

<details class="group rounded-lg border">
  <summary
    class="flex cursor-pointer list-none items-center gap-inline p-inset-x hover:bg-muted focus-visible:outline-2"
  >
    <svg
      class="size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-90 motion-reduce:transition-none"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
    >
    <span class:list={['font-medium', mono && 'font-mono']}>{title}</span>
    {hint && <span class="ml-auto hidden text-small text-muted-foreground sm:inline">{hint}</span>}
  </summary>
  <div class="flex flex-col gap-stack border-t p-inset-x">
    <slot />
  </div>
</details>
