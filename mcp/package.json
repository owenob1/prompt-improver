{
  "name": "prompt-improver-mcp",
  "version": "2.0.0",
  "private": true,
  "description": "Hosted MCP server for prompt-improver: hands the calling agent the generation instructions, then validates the XML spec it writes.",
  "type": "module",
  "scripts": {
    "pack": "node scripts/pack.mjs",
    "typecheck": "npm run pack && tsc --noEmit",
    "test": "npm run pack && vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^22.10.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.137.0",
    "yaml": "^2.9.1"
  }
}
