  "backend_commands": {
    "//": "Used when backend_invocation=commands (or auto with your own override). {prompt_file} {model} {model_args} {max_tokens} are substituted; {model} is shell-quoted. Scripts in scripts/backends/ add timeouts and large-prompt handling that these templates cannot.",
    "claude": "claude -p \"$(cat \"{prompt_file}\")\" --tools \"\" --output-format text --no-session-persistence --permission-mode dontAsk {model_args} </dev/null",
    "grok": "grok -p \"$(cat \"{prompt_file}\")\" --output-format plain --always-approve --no-subagents --no-plan --disable-web-search --max-turns 3 {model_args} </dev/null",
    "gemini": "gemini -p \"$(cat \"{prompt_file}\")\" --output-format text --approval-mode default {model_args} </dev/null",
    "codex": "codex exec --sandbox read-only --skip-git-repo-check --ephemeral --color never {model_args} - <\"{prompt_file}\"",
    "agy": "agy -p \"$(cat \"{prompt_file}\")\" --output-format text {model_args} </dev/null",
    "copilot": "copilot -p \"$(cat \"{prompt_file}\")\" -s --no-ask-user --deny-tool shell --deny-tool write {model_args} </dev/null",
    "cursor": "cursor-agent -p \"$(cat \"{prompt_file}\")\" --mode ask --output-format text {model_args} </dev/null",
    "opencode": "opencode run {model_args} \"$(cat \"{prompt_file}\")\" </dev/null",
    "cline": "cline --plan -y {model_args} \"$(cat \"{prompt_file}\")\" </dev/null",
    "qwen": "qwen -p \"$(cat \"{prompt_file}\")\" --output-format text --approval-mode default {model_args} </dev/null",
    "droid": "droid exec -f \"{prompt_file}\" {model_args} </dev/null",
    "amp": "amp -x <\"{prompt_file}\"",
    "kimi": "kimi -p \"$(cat \"{prompt_file}\")\" --output-format text {model_args} </dev/null",
    "kiro": "kiro-cli chat --no-interactive {model_args} \"$(cat \"{prompt_file}\")\" </dev/null"
  },
  "backend_model_flags": {
    "claude": "--model {model}",
    "grok": "-m {model}",
    "gemini": "-m {model}",
    "codex": "-m {model}",
    "agy": "--model {model}",
